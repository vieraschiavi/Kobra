{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "landing/**", "use": "@vercel/static" },
    { "src": "dashboard_estatico/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/", "dest": "/landing/index.html" },
    { "src": "/demo", "status": 308, "headers": { "Location": "/demo/" } },
    { "src": "/demo/", "dest": "/dashboard_estatico/index.html" },
    { "src": "/demo/(.+)", "dest": "/dashboard_estatico/$1" },
    { "src": "/(.*)", "dest": "/landing/$1" }
  ]
}
