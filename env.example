# MV Kobra AI · Plantilla de configuración
# ==========================================
# Copiá este archivo a `.env` y completá los valores:
#
#   cp env.example .env
#
# `.env` está en .gitignore y nunca se commitea. Esta plantilla SÍ se versiona,
# y por eso no lleva ningún valor real — solo los nombres y de dónde sale cada
# uno. (Se llama `env.example` y no `.env.example` a propósito: así ninguna
# regla que ignore o bloquee `.env*` se la lleva puesta por accidente.)
#
# Para saber qué falta y qué se rompe sin cada una:
#
#   python3 verificar_configuracion.py
#
# En Vercel no se usa este archivo: las mismas variables van en
# Project -> Settings -> Environment Variables, alcance Production, y hay que
# REDESPLEGAR después de cargarlas (una función serverless lee el entorno al
# arrancar, no en cada request).


# ---------------------------------------------------------------------------
# 1. COBRAR — sin esto no entra plata
# ---------------------------------------------------------------------------

# MercadoPago -> tu aplicación -> Credenciales de producción -> Access Token.
# Empieza con APP_USR-. Usá primero las de PRUEBA para el pago de test.
# SIN ESTO: el checkout devuelve 503 medio_pago_no_configurado (o cae al link
# fijo si configuraste MP_LINK_*).
MP_ACCESS_TOKEN=

# Opcionales, con default razonable.
# La cuenta de cobro es uruguaya (site MLU) y solo acepta UYU: mandar USD hace
# que MercadoPago rechace la preferencia y el checkout falle.
MP_CURRENCY=UYU
# Tipo de cambio de referencia, el mismo que muestra la landing.
MP_TASA_UYU=40

# Links de pago fijos por plan. Solo como respaldo si no hay MP_ACCESS_TOKEN.
MP_LINK_PRO=
MP_LINK_STARTER=


# ---------------------------------------------------------------------------
# 2. EMITIR LA LICENCIA — sin esto el cliente paga y no puede activar
# ---------------------------------------------------------------------------

# La mitad PRIVADA del par RS256. El par YA ESTÁ GENERADO: la pública está
# commiteada en backend_venta/licencia_clave.py. Pegá la privada tal cual,
# incluidas las líneas BEGIN/END.
# Para rotar:  python -m backend_venta.licencia_clave --nuevo-par
# SIN ESTO: el pago entra y NO se emite licencia.
KOBRA_LICENSE_PRIVATE_KEY=

# Secreto HS256 heredado. Solo para licencias viejas; RS256 es el camino
# actual. Si están las dos, RS256 manda.
KOBRA_LICENSE_SECRET=


# ---------------------------------------------------------------------------
# 3. ENTREGAR — sin esto el cliente paga y no recibe nada
# ---------------------------------------------------------------------------

# resend.com/api-keys -> Create API Key (Sending access).
# SIN ESTO: la licencia se emite y queda solo en el log de la función. No se
# entera nadie, ni el comprador ni vos.
RESEND_API_KEY=

# OJO: esta es la que más se pasa por alto. Con RESEND_API_KEY puesta pero sin
# dominio verificado, los mails salen del remitente compartido de prueba de
# Resend, que SOLO entrega a la casilla del titular de la cuenta: al comprador
# no le llega, y desde tu lado se ve todo bien porque a vos sí te llegó la
# copia. Verificá mvkobranzaia.com en Resend -> Domains primero.
# Formato:  MV Kobra AI <licencias@mvkobranzaia.com>
RESEND_FROM=

# GitHub -> fine-grained token con Contents: Read-only sobre vieraschiavi/Kobra.
# Es lo que deja bajar el instalador desde el release privado.
# SIN ESTO: nadie puede descargar el producto aunque haya pagado.
RELEASES_TOKEN=

# Apaga SOLO los avisos de intención de compra (poné 0/no/off/false).
# No uses RESEND_API_KEY como interruptor: es la MISMA clave con la que se le
# manda la licencia al comprador, así que borrarla deja a los clientes sin
# licencia.
AVISO_INTENCION=


# ---------------------------------------------------------------------------
# 4. PANEL DE VENTAS
# ---------------------------------------------------------------------------

# Lo inventás vos:  openssl rand -base64 24
# SIN ESTO: el monitor de ventas queda cerrado, que es lo correcto.
KOBRA_BACKEND_ADMIN_TOKEN=


# ---------------------------------------------------------------------------
# 5. IA — opcionales, el producto funciona sin ellas
# ---------------------------------------------------------------------------

# console.anthropic.com -> Settings -> API Keys.
# SIN ESTO: el agente negociador usa plantillas en vez de redactar.
ANTHROPIC_API_KEY=

# platform.openai.com/api-keys — transcripción Whisper.
# SIN ESTO: no hay transcripción en la nube.
OPENAI_API_KEY=

# Voz premium (elevenlabs.io). SIN ESTO: se usan las voces de Twilio/Polly,
# ya incluidas en la cuenta de Twilio del cliente.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=


# ---------------------------------------------------------------------------
# 6. TELEFONÍA Y WHATSAPP — las pone CADA CLIENTE, no vos
# ---------------------------------------------------------------------------
# Modelo BYO: la cuenta de Twilio es del cliente y Twilio le factura a él.
# Estas variables van en la instalación del cliente (pantalla Configuración),
# no en tu servidor. Ver docs/AYUDA_CLIENTE_VOZ_Y_WHATSAPP.md.

TWILIO_ACCOUNT_SID=
# Además de llamar, valida la FIRMA de los webhooks entrantes. Sin esta
# variable /voz/entrante y /voz/turno rechazan todo: no hay forma de verificar
# quién postea, y aceptar sin verificar deja que cualquiera meta respuestas en
# una llamada en curso.
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=

# URL pública del servicio de voz. La firma de Twilio se calcula sobre la URL
# exacta: si no coincide con la que configuraste en Twilio, se rechaza todo.
PUBLIC_BASE_URL=

# Token de acceso al servicio de tiempo real. Si no lo fijás, el servicio
# genera uno y lo muestra al arrancar.
KOBRA_REALTIME_TOKEN=


# ---------------------------------------------------------------------------
# 7. DÓNDE GUARDA LOS DATOS — solo si querés cambiar los defaults
# ---------------------------------------------------------------------------

KOBRA_CONFIG_DIR=
KOBRA_DATA_DIR=
