{
  "name": "mv-kobra-ai",
  "productName": "MV Kobra AI",
  "version": "1.3.9",
  "description": "MV Kobra AI · Plataforma de Cobranzas Inteligentes — predicción de pago, agente negociador y copiloto de calidad",
  "main": "main.js",
  "author": {
    "name": "MV Kobra AI",
    "email": "hola@mvkobranzaia.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mvkobraai.desktop",
    "productName": "MV Kobra AI",
    "artifactName": "MVKobraAI_Setup.exe",
    "directories": {
      "output": "dist_installer",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html"
    ],
    "extraResources": [
      {
        "from": "../dist/MVKobraAI",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "publisherName": "MV Kobra AI",
      "legalTrademarks": "MV Kobra AI"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MV Kobra AI",
      "uninstallDisplayName": "MV Kobra AI",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "es_ES",
        "pt_BR",
        "en_US"
      ],
      "multiLanguageInstaller": true,
      "license": "build/license_es.txt",
      "allowElevation": true,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "menuCategory": "MV Kobra AI",
      "runAfterFinish": true,
      "displayLanguageSelector": true,
      "warningsAsErrors": false
    },
    "copyright": "© MV Kobra AI. Todos los derechos reservados."
  },
  "homepage": "https://mvkobranzaia.com"
}
