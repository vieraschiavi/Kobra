__pycache__/
*.pyc
.DS_Store
node_modules/
.streamlit/
.ipynb_checkpoints/
.uploads/
# Exports de Canva: el maestro editable es el propio Canva (enlace en el
# README). Los originales pesan 85 MB entre los cuatro y no van al historial;
# sí viaja la version comprimida, que es la que alguien necesita para mostrar
# la presentacion sin tener acceso al Canva.
# Se excluye el CONTENIDO y no el directorio: git no puede volver a incluir un
# archivo si su carpeta esta excluida, asi que la negacion no funcionaria.
presentation/canva/*
!presentation/canva/Kobra_Canva_Honesta_comprimido.pdf
!presentation/canva/LEEME.md
dist/
backups/

# Datos personales/privados de prueba — NUNCA se commitean (Ley 18.331).
# El producto vendible sigue siendo 100% sintético; esto queda solo en tu máquina.
data/mi_cartera_prueba.csv
data/*_prueba.csv
data/no_contactar.csv
data/auditoria.log
data/uso_licencias.db
data/*.lock

# Datos reales cargados por el cliente en runtime (cartera real, solicitudes,
# evaluaciones de calidad acumuladas, estado de origen) — nunca al repo.
data/calidad_evaluaciones.csv
data/solicitudes_real.csv
data/tenants/
outputs/kobra_cartera_real.csv
outputs/origen_cartera.json

# Temporary session build scripts (video, mocks) — not repo deliverables
scratchpad/

# Voz premium del chatvoice de demo, pre-renderizada en build time con la key
# de ElevenLabs de quien empaqueta (packaging/build_release.py) — nunca al repo.
# El audio pre-renderizado del chatvoice SI se versiona: lo sirve el sitio.
# Estuvo ignorado y el demo hospedado nunca lo tuvo --- daba 404 y caia a la
# voz robotica del navegador; los MP3 solo viajaban dentro del ZIP offline.
# Son 1,4 MB los tres idiomas, y regenerarlos cuesta ~25 min de CPU por idioma
# y tener instalado el clonador, asi que no es algo que se rehaga en cada clon.
# (antes: dashboard_estatico/audio_demo/)

# App de escritorio Electron (build local)
electron/dist_installer/

# Entornos que crean los .bat auto-instalantes (owner / construir_instalador)
.kobra_venv/
.kobra_node/
.kobra_node_tmp/

# Marca de edicion que escribe el workflow release_owner.yml antes de correr
# PyInstaller. Si quedara commiteada, el instalador de CLIENTES se armaria como
# Owner: entraria sin licencia y regalaria el producto.
/edicion.json
data/pagos_portal.csv
# Corriendo desde un checkout, DIR_DATOS puede ser la raíz del repo y el
# portal deja su registro acá en vez de en data/.
/pagos_portal.csv
/imputaciones_erp.jsonl
data/imputaciones_erp.jsonl
data/portal_config.json
data/tenants/*/pagos_portal.csv
data/tenants/*/imputaciones_erp.jsonl
data/tenants/*/portal_config.json

# Contador de gestiones del plan (kobra/plan.py). Es estado LOCAL de una copia
# instalada: se genera al correr la app o los tests desde el repo y no tiene
# nada que hacer en el control de versiones.
uso_plan.json
uso_plan.json.lock
data/cartera_entrante.csv

# Generado por packaging/generar_owner_bat.py con el token firmado del dueño.
# No se commitea: un Owner.bat con sello válido convierte cualquier instalación
# en la edición sin límites.
packaging/Owner.bat
