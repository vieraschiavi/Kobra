# Copiá este archivo a .env y completá los valores.
# .env NO se commitea nunca: está en .gitignore.
#
# Los valores salen de tu app en https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Tiene que coincidir EXACTO con la "Authorized redirect URL" de la app,
# incluida la barra final o su ausencia. LinkedIn compara el string completo.
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback

# Opcionales:
# LINKEDIN_API_VERSION=202608
# LINKEDIN_TOKEN_PATH=~/.mv-linkedin-token.json
